{
  "name": "chat-app-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@react-navigation/elements": "2.9.38"
  },
  "scripts": {
    "android": "react-native run-android --no-packager --port 8081",
    "android:doctor": "bash scripts/android-doctor.sh",
    "android:local": "bash scripts/run-android-local.sh",
    "ios": "react-native run-ios",
    "ios:doctor": "bash scripts/ios-doctor.sh",
    "ios:local": "bash scripts/run-ios-local.sh",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "adb": "adb reverse tcp:8081 tcp:8081",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "clean:ios": "rm -rf ios/Pods && rm -rf ios/Podfile.lock",
    "build:android": "cd android && ./gradlew assembleRelease",
    "release:android": "cd android && ./gradlew bundleRelease",
    "pod": "cd ios && pod install && cd ..",
    "test": "jest --config jest.config.js --runInBand",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix ./src/**/*.{ts,tsx}",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:src": "prettier --check ./src/**/*.{ts,tsx}",
    "format:src:fix": "prettier --write ./src/**/*.{ts,tsx}",
    "rename": "react-native-rename",
    "detox-build:ios": "detox build --configuration ios.sim.debug",
    "detox-test:ios": "detox test --configuration ios.sim.debug",
    "detox-build:android": "detox build --configuration android.emu.debug",
    "detox-test:android": "detox test --configuration android.emu.debug"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/elements": "2.9.38",
    "@react-navigation/native": "7.3.16",
    "@react-navigation/native-stack": "7.18.8",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.3",
    "react-hook-form": "7.85.0",
    "react-native": "0.87.0",
    "react-native-device-info": "^15.0.2",
    "react-native-get-random-values": "2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.27.0",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.3.0",
    "socket.io-client": "^4.8.3",
    "uuid": "14.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
